# 複製成 .env 後填入實際值；.env 不可提交到 GitHub

# 資料來源
DUFFEL_API_TOKEN=
TRAVELPAYOUTS_TOKEN=

# 通知
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# 資料庫與佇列（docker compose 內部預設）
DATABASE_URL=postgresql+psycopg://tracker:tracker@postgres:5432/tracker
REDIS_URL=redis://redis:6379/0

# 寫進 User-Agent 的聯絡信箱
CRAWLER_CONTACT_EMAIL=
# User-Agent 中的服務名稱
CRAWLER_SERVICE_NAME=TravelPriceTrackerBot

# 合規閘門參數
# 來源審閱有效天數（超過即拒絕執行）
SOURCE_REVIEW_MAX_AGE_DAYS=180
# robots.txt 快取秒數
ROBOTS_CACHE_TTL_SECONDS=86400
# 預算告警門檻（百分比）
BUDGET_ALERT_PERCENT=80
# 對外請求逾時秒數
HTTP_TIMEOUT_SECONDS=20
# 稽核日誌保留天數
FETCH_LOG_RETENTION_DAYS=365
