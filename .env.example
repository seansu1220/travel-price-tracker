# 複製成 .env 後填入實際值；.env 不可提交到 GitHub

# 資料來源
DUFFEL_API_TOKEN=
TRAVELPAYOUTS_TOKEN=

# 通知
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# 資料庫與佇列（docker compose 內部預設）
DATABASE_URL=postgresql+psycopg://tracker:tracker@postgres:5432/tracker
REDIS_URL=redis://redis:6379/0

# 寫進 User-Agent 的聯絡信箱
CRAWLER_CONTACT_EMAIL=
# User-Agent 中的服務名稱
CRAWLER_SERVICE_NAME=TravelPriceTrackerBot

# 合規閘門參數
# 來源審閱有效天數（超過即拒絕執行）
SOURCE_REVIEW_MAX_AGE_DAYS=180
# 新來源未指定時的限速預設值
SOURCE_DEFAULT_MIN_INTERVAL_SECONDS=10
SOURCE_DEFAULT_DAILY_CALL_LIMIT=500
# robots.txt 快取秒數
ROBOTS_CACHE_TTL_SECONDS=86400
# robots.txt 無法確認時多久後再試（秒）
ROBOTS_UNAVAILABLE_RETRY_SECONDS=3600
# 抓 robots.txt 時最多跟隨幾次轉址（只限同網域或其子網域）
ROBOTS_MAX_REDIRECTS=5
# 同一事件告警的去重秒數
ALERT_DEDUPE_SECONDS=86400
# 預算告警門檻（百分比）
BUDGET_ALERT_PERCENT=80
# 對外請求逾時秒數
HTTP_TIMEOUT_SECONDS=20
# 稽核日誌保留天數
FETCH_LOG_RETENTION_DAYS=365
